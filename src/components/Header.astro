---
import { ThemeSwitch } from "free-astro-components";
import Hamburguer from "./Hamburguer.astro";

const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
const homeUrl = base ? `${base}/` : "/";
const postsUrl = `${base}/posts`;
const docUrl = `${base}/posts/who-we-are`;
---

<header
  class="fixed inset-x-0 top-0 bg-neutral-100/60 text-neutral-700 py-4 border-b border-neutral-300/50 backdrop-blur-md z-20"
>
  <div class="container flex justify-between items-center gap-8">
    <a
      class="flex items-center gap-3 text-primary hover:text-secondary text-4xl font-bold leading-none transition duration-300 ease-in-out"
      href={homeUrl}
      aria-label="YouthX"
    >
      <img src={`${base}/logo.png`} alt="YouthX" class="w-8 h-8 rounded-lg object-contain" />
      <span class="text-xl font-bold tracking-tight text-neutral-700">YouthX</span>
    </a>

    <nav>
      <ul class="flex items-center gap-8">
        <li>
          <a
            class="text-sm hover:text-primary transition duration-300 ease-in-out"
            href={postsUrl}>Articles</a
          >
        </li>
        <li>
          <a
            class="text-sm hover:text-primary transition duration-300 ease-in-out"
            href={docUrl}>Documentation</a
          >
        </li>
        <li>
          <ThemeSwitch />
        </li>
        <li class="lg:hidden">
          <Hamburguer />
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import { DOMLoaded } from "../ts/utils";

  DOMLoaded(() => {
    const body = document.querySelector("body") as HTMLElement;
    const hamburguer = document.querySelector(
      "[data-hamburguer]"
    ) as HTMLButtonElement | null;
    const nav = document.querySelector("[data-nav]") as HTMLElement | null;

    if (hamburguer && nav && body) {
      hamburguer.addEventListener("click", () => {
        hamburguer.toggleAttribute("open");
        nav.toggleAttribute("open");
        body.classList.toggle("overflow-hidden");
      });
    }
  });
</script>
