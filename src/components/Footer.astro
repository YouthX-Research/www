---
const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
const homeUrl = base ? `${base}/` : "/";
const postsUrl = `${base}/posts`;
const docUrl = `${base}/posts/who-we-are`;
const humaUrl = `${base}/posts/breaking-the-syntax-barrier-the-impact-of-native-turkish-programming-language-on-algorithmic-thinking`;
const certDocxUrl = `${base}/sessionchair_certificate.docx`;
const certPngUrl = `${base}/sessionchair_certificate.png`;
---

<footer class="py-12 border-t border-neutral-300/40 bg-neutral-100 text-neutral-700">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
      <!-- Col 1: Brand -->
      <div class="flex flex-col gap-4">
        <a
          href={homeUrl}
          class="flex items-center gap-2.5 text-primary hover:text-secondary transition duration-300 ease-in-out"
          aria-label="YouthX"
        >
          <img src={`${base}/logo.png`} alt="YouthX Logo" class="w-9 h-9 rounded-lg object-contain" />
          <span class="text-2xl font-bold tracking-tight text-neutral-700">YouthX</span>
        </a>
        <p class="text-sm text-neutral-500 leading-relaxed">
          YouthX is <strong>Open</strong> Useful Technologies Hub’s Experiments. An open research collective dedicated to ethical AI, native programming, and open computing technologies.
        </p>
        <div class="flex items-center gap-4 text-sm text-neutral-500 pt-2">
          <a
            href="https://www.instagram.com/youthx_research/"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-primary transition-colors font-medium"
          >
            Instagram ↗
          </a>
          <a
            href="https://github.com/YouthX-Research"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-primary transition-colors font-medium"
          >
            GitHub ↗
          </a>
        </div>
      </div>

      <!-- Col 2: Founder -->
      <div class="flex flex-col gap-3">
        <h4 class="text-neutral-700 font-medium text-base">Founder & Lead Researcher</h4>
        <div class="flex flex-col gap-2 text-sm text-neutral-500">
          <span class="font-medium text-neutral-700 text-base">Egehan KAHRAMAN</span>
          <a href="https://egehankahraman.vercel.app" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
            🌐 egehankahraman.vercel.app ↗
          </a>
          <a href="https://github.com/vastsea0" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
            🐙 GitHub (@vastsea0) ↗
          </a>
          <a href="https://www.youtube.com/@egehankhrmn" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
            📺 YouTube (@egehankhrmn) ↗
          </a>
          <a href="https://www.instagram.com/egehan.dev" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
            📸 Instagram (@egehan.dev) ↗
          </a>
        </div>
      </div>

      <!-- Col 3: Projects -->
      <div class="flex flex-col gap-3">
        <h4 class="text-neutral-700 font-medium text-base">Projects & Initiatives</h4>
        <ul class="text-neutral-500 text-sm flex flex-col gap-2">
          <li>
            <a href={humaUrl} class="hover:text-primary transition-colors">
              Hüma Programlama Dili
            </a>
          </li>
          <li>
            <a href="https://github.com/VastSea0/hilal-browser" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
              Hilal Browser ↗
            </a>
          </li>
          <li>
            <a href="https://github.com/YouthX-Research/nasa-hackathon" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
              NASA Space Apps Challenge ↗
            </a>
          </li>
          <li>
            <a href="https://genctek-sunum.vercel.app" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
              GençTek: Veriden Yapay Zekâya ↗
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Documents & Resources -->
      <div class="flex flex-col gap-3">
        <h4 class="text-neutral-700 font-medium text-base">Documents & Resources</h4>
        <ul class="text-neutral-500 text-sm flex flex-col gap-2">
          <li><a href={postsUrl} class="hover:text-primary transition-colors">Articles & Experiments</a></li>
          <li><a href={docUrl} class="hover:text-primary transition-colors">Who We Are (Manifesto)</a></li>
          <li>
            <a href={certDocxUrl} download="sessionchair_certificate.docx" class="hover:text-primary transition-colors inline-flex items-center gap-1.5">
              <span>ICETOL Session Chair (.docx)</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-primary/10 text-primary font-mono">Download</span>
            </a>
          </li>
          <li>
            <a href={certPngUrl} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
              Session Chair Certificate (PNG) ↗
            </a>
          </li>
          <li>
            <a href="https://github.com/YouthX-Research/nasa-hackathon" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
              NASA Hackathon Repository ↗
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t border-neutral-300/40 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-neutral-500">
      <p>© {new Date().getFullYear()} YouthX Research. All rights reserved.</p>
      <p>Founder: Egehan Kahraman · Open Useful Technologies Hub</p>
    </div>
  </div>
</footer>
