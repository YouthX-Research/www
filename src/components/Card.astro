---
import { Icon } from 'free-astro-components'

interface Props {
  body?: string
  type: 'primary' | 'secondary' | 'light'
  icon?: string
  title?: string
  description?: string
}

const { icon, title, description, body } = Astro.props;
const cardDesc = description || body;

const cardClasses = [
  'flex flex-col gap-8 h-full bg-gradient-to-r from-primary/10 via-neutral-900/40 to-secondary/10 rounded-3xl p-8 border border-white/5 hover:border-primary/30 transition-all duration-300',
]
  .filter(Boolean)
  .join(' ')

const iconClasses = ['w-20 h-20 text-primary'].filter(Boolean).join(' ')
---

<article class={cardClasses}>
  <div>
    <Icon icon={icon} class={iconClasses} />
  </div>
  <div class="flex flex-col gap-4">
    <h3 class="text-neutral-900 dark:text-neutral-100 text-2xl lg:text-3xl font-semibold">{title}</h3>
    <p class="flex-1 text-neutral-600 dark:text-neutral-400 leading-relaxed">{cardDesc}</p>
  </div>
</article>
