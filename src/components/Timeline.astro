---
const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
const humaArticleUrl = `${base}/posts/breaking-the-syntax-barrier-the-impact-of-native-turkish-programming-language-on-algorithmic-thinking`;
const certDocxUrl = `${base}/sessionchair_certificate.docx`;
const certPngUrl = `${base}/sessionchair_certificate.png`;

interface TimelineItem {
  date: string;
  text: string;
  links?: { label: string; href: string; download?: string; target?: string }[];
}

const items: TimelineItem[] = [
  {
    date: "August 2026",
    text: "Presented 'A Turkish Grammar-Aware Approach to Introductory Programming' and served as Session Chair at the ICETOL 2026 International Conference in Bremen, Germany.",
    links: [
      { label: "Certificate (.docx)", href: certDocxUrl, download: "sessionchair_certificate.docx" },
      { label: "Certificate (PNG)", href: certPngUrl, target: "_blank" },
      { label: "Paper →", href: humaArticleUrl }
    ]
  },
  {
    date: "June – July 2026",
    text: "Delivered the 6-session applied 'Veriden Yapay Zekâya' machine learning and data science curriculum at GençTek Kahramanmaraş.",
    links: [
      { label: "Curriculum Overview →", href: `${base}/posts/who-we-are` }
    ]
  },
  {
    date: "October 2025",
    text: "Developed an automated satellite meteorological analysis and AI forecasting system for the NASA Space Apps Challenge using EarthData and Gemini.",
    links: [
      { label: "GitHub ↗", href: "https://github.com/YouthX-Research/nasa-hackathon", target: "_blank" }
    ]
  },
  {
    date: "2025",
    text: "Engineered Hilal Browser, an independent, privacy-focused desktop web browser built on Mozilla Gecko with Google Material 3 Expressive UI.",
    links: [
      { label: "GitHub ↗", href: "https://github.com/VastSea0/hilal-browser", target: "_blank" }
    ]
  },
  {
    date: "Early 2025",
    text: "Created Hüma Programlama Dili, a native Turkish-syntax programming language designed to eliminate the English syntax barrier in introductory computer science education.",
    links: [
      { label: "Research Paper →", href: humaArticleUrl }
    ]
  }
];
---

<section class="py-12 lg:py-20 border-t border-neutral-300/40">
  <div class="container max-w-3xl flex flex-col gap-8">
    <div class="flex flex-col gap-1">
      <span class="text-xs uppercase tracking-widest text-primary font-mono">Milestones</span>
      <h2 class="text-2xl lg:text-3xl font-medium text-neutral-700">Chronological Timeline</h2>
    </div>

    <div class="divide-y divide-neutral-300/40">
      {items.map((item) => (
        <div class="py-4 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 text-sm">
          <span class="font-mono text-xs text-neutral-500 shrink-0 sm:w-36">{item.date}</span>
          <div class="flex-1 flex flex-col gap-1.5">
            <p class="text-neutral-700 leading-relaxed font-light">{item.text}</p>
            {item.links && item.links.length > 0 && (
              <div class="flex flex-wrap items-center gap-3 text-xs">
                {item.links.map((link) => (
                  <a
                    href={link.href}
                    target={link.target || "_self"}
                    download={link.download || undefined}
                    rel={link.target === "_blank" ? "noopener noreferrer" : undefined}
                    class="text-primary hover:underline font-medium inline-flex items-center gap-1"
                  >
                    <span>{link.label}</span>
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
