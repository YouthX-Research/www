---
import { Button } from "free-astro-components";
import Code from "../components/Code.astro";
import CTA from "../sections/CTA.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../sections/Hero.astro";
import Intro from "../sections/Intro.astro";
import Layout from "../layouts/Layout.astro";
import Sidebar from "../layouts/Sidebar.astro";

const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
const startUrl = `${base}/posts/who-we-are`;
const postsUrl = `${base}/posts`;
const humaUrl = `${base}/posts/breaking-the-syntax-barrier-the-impact-of-native-turkish-programming-language-on-algorithmic-thinking`;
const certDocxUrl = `${base}/sessionchair_certificate.docx`;
const certPngUrl = `${base}/sessionchair_certificate.png`;
---

<Layout title="YouthX — Open Useful Technologies Hub's Experiments">
  <Sidebar class="lg:hidden" />
  <Header />
  <main>
    <!-- Hero Section -->
    <Hero
      align="center"
      title="YouthX"
      description="YouthX is Open Useful Technologies Hub’s Experiments — An open research collective dedicated to experimenting with useful, ethical AI technologies and native programming paradigms."
    >
      <div class="flex items-center gap-3">
        <Button href={startUrl} label="Get started" />
        <a
          href={postsUrl}
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-full text-sm font-medium border border-neutral-300/70 hover:border-primary text-neutral-700 hover:text-primary transition duration-200"
        >
          Articles
        </a>
      </div>
      <div>
        <Code code="echo 'Hello world!' " />
      </div>
    </Hero>

    <!-- Recent Milestones & Academic Leadership -->
    <section class="py-12 lg:py-16 border-t border-b border-neutral-300/40">
      <div class="container flex flex-col gap-8">
        <div class="flex flex-col gap-2">
          <span class="text-xs uppercase tracking-widest text-primary font-medium">Recent Milestones</span>
          <h2 class="text-neutral-700 text-3xl font-medium">Academic Research & Educational Initiatives</h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- ICETOL 2026 Card -->
          <div class="flex flex-col justify-between p-6 sm:p-8 rounded-3xl border border-neutral-300/50 bg-neutral-200/30 hover:border-primary/50 transition-all duration-300">
            <div class="flex flex-col gap-4">
              <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-neutral-500">
                <span class="px-2.5 py-1 rounded-full border border-primary/30 text-primary font-medium bg-primary/5">
                  Conference & Session Chair
                </span>
                <span>August 17–20, 2026 · Bremen, Germany</span>
              </div>
              <h3 class="text-xl sm:text-2xl font-medium text-neutral-700">
                ICETOL 2026: A Turkish Grammar-Aware Approach to Introductory Programming
              </h3>
              <p class="text-sm text-neutral-500 leading-relaxed">
                Presentation of our research on the Hüma native programming language at the International Conference of Educational Technology and Online Learning. In recognition of academic leadership, <strong>Egehan Kahraman served as Session Chair</strong> during the proceedings.
              </p>
            </div>

            <div class="mt-6 pt-6 border-t border-neutral-300/40 flex flex-wrap items-center gap-3 text-xs font-medium">
              <a
                href={certDocxUrl}
                download="sessionchair_certificate.docx"
                class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-primary text-white hover:opacity-90 transition-opacity"
              >
                <span>Download Certificate (.docx)</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
              </a>
              <a
                href={certPngUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-neutral-300/70 hover:border-primary text-neutral-700 hover:text-primary transition-colors"
              >
                <span>View Certificate (PNG) ↗</span>
              </a>
              <a
                href={humaUrl}
                class="inline-flex items-center gap-1.5 px-3.5 py-2 text-primary hover:underline transition-all"
              >
                <span>Read Research Paper →</span>
              </a>
            </div>
          </div>

          <!-- From Data to AI Curriculum Card -->
          <div class="flex flex-col justify-between p-6 sm:p-8 rounded-3xl border border-neutral-300/50 bg-neutral-200/30 hover:border-secondary/50 transition-all duration-300">
            <div class="flex flex-col gap-4">
              <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-neutral-500">
                <span class="px-2.5 py-1 rounded-full border border-secondary/40 text-secondary font-medium bg-secondary/5">
                  Applied AI Curriculum
                </span>
                <span>6 Intensive Sessions · GençTek</span>
              </div>
              <h3 class="text-xl sm:text-2xl font-medium text-neutral-700">
                From Data to AI (Veriden Yapay Zekâya): Applied ML Course
              </h3>
              <p class="text-sm text-neutral-500 leading-relaxed">
                A practical curriculum authored and instructed by Egehan Kahraman at GençTek. Spanning exploratory data analysis, feature engineering, classical ML models, deep neural networks, and prompt engineering with modern large language models.
              </p>
            </div>

            <div class="mt-6 pt-6 border-t border-neutral-300/40 flex flex-wrap items-center gap-3 text-xs font-medium">
              <a
                href={startUrl}
                class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-neutral-300/70 hover:border-secondary text-neutral-700 hover:text-secondary transition-colors"
              >
                <span>Explore in About & Docs →</span>
              </a>
              <a
                href="https://github.com/YouthX-Research"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3.5 py-2 text-neutral-500 hover:text-neutral-700 transition-colors"
              >
                <span>YouthX GitHub Repositories ↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Projects & Initiatives -->
    <section class="py-12 lg:py-20">
      <div class="container flex flex-col gap-10">
        <div class="flex flex-col gap-2">
          <span class="text-xs uppercase tracking-widest text-primary font-medium">Open Source Ecosystem</span>
          <h2 class="text-neutral-700 text-3xl lg:text-4xl font-medium">Featured Projects & Initiatives</h2>
          <p class="text-neutral-500 text-base max-w-2xl">
            From native-syntax programming languages to independent browsers and satellite data intelligence, we develop open technologies for everyone.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Hüma -->
          <a
            href={humaUrl}
            class="group flex flex-col justify-between p-6 rounded-3xl border border-neutral-300/40 bg-neutral-200/20 hover:bg-neutral-200/50 hover:border-primary/40 transition-all duration-300"
          >
            <div class="flex flex-col gap-3">
              <span class="text-xs text-primary font-medium">Programming Language</span>
              <h3 class="text-lg font-medium text-neutral-700 group-hover:text-primary transition-colors">
                Hüma Programming Language
              </h3>
              <p class="text-xs text-neutral-500 leading-relaxed">
                High-level language built around native Turkish grammar and agglutinative word order, removing the English barrier in computer science education.
              </p>
            </div>
            <span class="mt-4 text-xs text-primary font-medium flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Read Research Paper →
            </span>
          </a>

          <!-- Hilal Browser -->
          <a
            href="https://github.com/YouthX-Research/huma-browser"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col justify-between p-6 rounded-3xl border border-neutral-300/40 bg-neutral-200/20 hover:bg-neutral-200/50 hover:border-primary/40 transition-all duration-300"
          >
            <div class="flex flex-col gap-3">
              <span class="text-xs text-primary font-medium">Modern Web Browser</span>
              <h3 class="text-lg font-medium text-neutral-700 group-hover:text-primary transition-colors">
                Hilal Browser
              </h3>
              <p class="text-xs text-neutral-500 leading-relaxed">
                An independent, privacy-focused desktop browser built on Mozilla Gecko with Google Material 3 Expressive UI design and custom productivity tooling.
              </p>
            </div>
            <span class="mt-4 text-xs text-primary font-medium flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              GitHub Repository ↗
            </span>
          </a>

          <!-- NASA Space Apps Challenge -->
          <a
            href="https://github.com/YouthX-Research/nasa-hackathon"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col justify-between p-6 rounded-3xl border border-neutral-300/40 bg-neutral-200/20 hover:bg-neutral-200/50 hover:border-primary/40 transition-all duration-300"
          >
            <div class="flex flex-col gap-3">
              <span class="text-xs text-primary font-medium">Space & Geospatial AI</span>
              <h3 class="text-lg font-medium text-neutral-700 group-hover:text-primary transition-colors">
                NASA Space Apps Challenge
              </h3>
              <p class="text-xs text-neutral-500 leading-relaxed">
                Automated meteorological and climate analysis platform utilizing NASA EarthData satellite datasets (EarthAccess API) and Google Gemini AI insights.
              </p>
            </div>
            <span class="mt-4 text-xs text-primary font-medium flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              GitHub Repository ↗
            </span>
          </a>

          <!-- GençTek AI Training -->
          <a
            href={startUrl}
            class="group flex flex-col justify-between p-6 rounded-3xl border border-neutral-300/40 bg-neutral-200/20 hover:bg-neutral-200/50 hover:border-primary/40 transition-all duration-300"
          >
            <div class="flex flex-col gap-3">
              <span class="text-xs text-primary font-medium">AI Education</span>
              <h3 class="text-lg font-medium text-neutral-700 group-hover:text-primary transition-colors">
                GençTek AI Courses
              </h3>
              <p class="text-xs text-neutral-500 leading-relaxed">
                "From Data to AI" 6-session applied curriculum training youth in data preparation, machine learning algorithms, deep neural nets, and AI ethics.
              </p>
            </div>
            <span class="mt-4 text-xs text-primary font-medium flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Curriculum Overview →
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- Founder Section -->
    <section class="py-12 lg:py-16 border-t border-neutral-300/40 bg-neutral-200/10">
      <div class="container">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8 p-8 rounded-3xl border border-neutral-300/50 bg-neutral-200/30">
          <div class="flex flex-col gap-3 max-w-xl">
            <span class="text-xs uppercase tracking-widest text-primary font-medium">Founder & Lead Researcher</span>
            <h3 class="text-2xl lg:text-3xl font-medium text-neutral-700">Egehan KAHRAMAN</h3>
            <p class="text-sm text-neutral-500 leading-relaxed">
              Founder of YouthX Research; researcher and software engineer focusing on native programming language paradigms (Hüma), modern web browsers (Hilal), and open, accessible AI technologies.
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-3 text-sm">
            <a
              href="https://egehankahraman.vercel.app"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl border border-neutral-300/70 hover:border-primary text-neutral-700 hover:text-primary transition-colors"
            >
              Website ↗
            </a>
            <a
              href="https://github.com/vastsea0"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl border border-neutral-300/70 hover:border-primary text-neutral-700 hover:text-primary transition-colors"
            >
              GitHub ↗
            </a>
            <a
              href="https://www.youtube.com/@egehankhrmn"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl border border-neutral-300/70 hover:border-primary text-neutral-700 hover:text-primary transition-colors"
            >
              YouTube ↗
            </a>
            <a
              href="https://www.instagram.com/egehan.dev"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl border border-neutral-300/70 hover:border-primary text-neutral-700 hover:text-primary transition-colors"
            >
              Instagram ↗
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Intro Section -->
    <Intro />

    <!-- Call to Action -->
    <CTA
      align="center"
      title="Freedom. Curiosity. Experimentation."
      description="Discover who we are, why YOUTHX exists, and how we experiment with open and useful technologies for everyone."
    >
      <div class="flex flex-wrap items-center justify-center gap-4">
        <Button href={startUrl} label="Get started" />
        <a
          href="https://www.instagram.com/youthx_research/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-2.5 rounded-full text-sm font-medium border border-neutral-300/70 hover:border-primary text-neutral-700 hover:text-primary transition duration-200"
        >
          Follow on Instagram ↗
        </a>
        <a
          href="https://github.com/YouthX-Research"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-2.5 rounded-full text-sm font-medium border border-neutral-300/70 hover:border-primary text-neutral-700 hover:text-primary transition duration-200"
        >
          GitHub Organization ↗
        </a>
      </div>
    </CTA>
  </main>
  <Footer />
</Layout>
