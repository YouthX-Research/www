---
import { getCollection, type CollectionEntry } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Label from '../../components/Label.astro'

export const prerender = true

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

const { post } = Astro.props as { post: CollectionEntry<'posts'> }
const { Content } = await post.render()
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '')
---

<Layout title={`${post.data.title} · YouthX Research`} description={post.data.description}>
  <div class="wrap">
    <header class="page-head">
      <Label>Writing</Label>
      <h1 class="rise">{post.data.title}</h1>
      {
        post.data.publishDate && (
          <p class="meta rise" style="--d:1">
            {post.data.author} ·{' '}
            {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </p>
        )
      }
    </header>
    <article class="prose rise" style="--d:2">
      <Content />
    </article>
    <a class="link back" href={`${base}/posts`}>← All writing</a>
  </div>
</Layout>
