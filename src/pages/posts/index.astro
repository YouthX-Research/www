---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Label from '../../components/Label.astro'

export const prerender = true

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '')
const posts = (await getCollection('posts')).sort(
  (a, b) => (b.data.publishDate?.getTime() ?? 0) - (a.data.publishDate?.getTime() ?? 0),
)
---

<Layout title="Writing · YouthX Research">
  <div class="wrap">
    <header class="page-head">
      <Label>Writing</Label>
      <h1 class="rise">Papers, notes and write-ups</h1>
    </header>
    <ul class="post-list">
      {
        posts.map((post, i) => (
          <li data-reveal style={`--d:${i}`}>
            <a href={`${base}/posts/${post.slug}`}>
              <time>
                {post.data.publishDate?.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <div>
                <h2>{post.data.title}</h2>
                {post.data.description && <p>{post.data.description}</p>}
              </div>
              <span class="go" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
