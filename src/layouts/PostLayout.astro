---
import Header from "../components/Header.astro"
import Layout from "./Layout.astro"
import Sidebar from "./Sidebar.astro"
import Content from "./Content.astro"
import Article from "../components/Article.astro"
import Heading from "../components/Heading.astro"

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} - YOUTHX`}>
  <Header />
  <Sidebar />
  <Content>
    <section>
      <Article>
        <Heading
          slot="header"
          level={1}
          gradient
          class="inline-block"
          text={frontmatter.title}
        />
        <div class="prose max-w-none 
          prose-headings:font-medium prose-p:font-light 
          prose-a:text-primary hover:prose-a:text-secondary
          prose-img:rounded-xl">
          <slot />
        </div>
      </Article>
    </section>
  </Content>
</Layout>

<style is:global>
  /* Adaptive Theme Prose Styles */
  .prose {
    --tw-prose-body: rgb(var(--ac-color-600));
    --tw-prose-headings: rgb(var(--ac-color-700));
    --tw-prose-lead: rgb(var(--ac-color-500));
    --tw-prose-links: rgb(var(--ac-primary));
    --tw-prose-bold: rgb(var(--ac-color-700));
    --tw-prose-counters: rgb(var(--ac-color-400));
    --tw-prose-bullets: rgb(var(--ac-primary));
    --tw-prose-hr: rgb(var(--ac-color-300));
    --tw-prose-quotes: rgb(var(--ac-color-700));
    --tw-prose-quote-borders: rgb(var(--ac-primary));
    --tw-prose-captions: rgb(var(--ac-color-400));
    --tw-prose-code: rgb(var(--ac-color-700));
    --tw-prose-pre-code: rgb(var(--ac-color-600));
    --tw-prose-pre-bg: rgb(var(--ac-color-200));
    --tw-prose-th-borders: rgb(var(--ac-color-300));
    --tw-prose-td-borders: rgb(var(--ac-color-300));
  }
</style>
